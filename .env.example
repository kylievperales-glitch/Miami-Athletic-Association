# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables. See SETUP-CALENDAR.md.

# ── Site ──────────────────────────────────────────────────────────────────────
# Public address of the site, no trailing slash. Used in email links.
NEXT_PUBLIC_SITE_URL=

# ── Supabase (calendar database + admin sign-in) ─────────────────────────────
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects call it the "anon" key). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (older projects: "service_role"). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave blank until a sending domain is verified in Resend. Nothing is sent while blank.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g.
# Miami Athletic Association <calendar@your-domain.com>
EMAIL_FROM=
# Where replies go. Defaults to miamiathleticassociation@gmail.com.
EMAIL_REPLY_TO=miamiathleticassociation@gmail.com
# Who gets "new submission" alerts. Comma-separated.
ADMIN_NOTIFICATION_EMAILS=

# Long random string. Protects the daily email-retry job (/api/cron/emails).
CRON_SECRET=

# ── Spam protection (optional) ────────────────────────────────────────────────
# Cloudflare Turnstile. Both must be set to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Local preview only ────────────────────────────────────────────────────────
# CALENDAR_DEMO=1 shows clearly-labeled sample events with `npm run dev`.
# Ignored in production builds.
# CALENDAR_DEMO=1

# ── Other forms (unchanged; optional) ─────────────────────────────────────────
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_PARTNERSHIP_ENDPOINT=
NEXT_PUBLIC_INQUIRY_ENDPOINT=
